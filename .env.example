# App
APP_NAME=Spider
APP_ENV=local
APP_DEBUG=true
APP_PRETTY_LOGS=true
APP_LOG_FLOW_STEPS=true
APP_LOG_LLM_PROMPTS=false
APP_LOG_LLM_OUTPUTS=false
APP_LOG_PREVIEW_CHARS=600

# Local persistence (defaults to ./data/spider-ai.db)
SPIDER_AI_DB_PATH=./data/spider-ai.db
SPIDER_AI_SEC_FILINGS_PATH=./data/sec-filings
SPIDER_AI_CHROMA_PATH=./data/chroma

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:14b
# Optional pinned tokenizer for precise generation-model counting.
THESIS_RAG_CHAT_TOKENIZER_MODEL=qwen3:14b
THESIS_RAG_CHAT_TOKENIZER_ID=Qwen/Qwen3-14B
THESIS_RAG_CHAT_TOKENIZER_REVISION=40c069824f4251a91eefaf281ebe4c544efd3e18
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# Change this when the locally installed embedding model weights/configuration change.
OLLAMA_EMBEDDING_MODEL_REVISION=local-v1
OLLAMA_EMBEDDING_BATCH_SIZE=32
OLLAMA_EMBEDDING_EXPECTED_DIMENSIONS=768
OLLAMA_EMBEDDING_MAX_INPUT_CHARS=1600
OLLAMA_EMBEDDING_MAX_INPUT_TOKENS=450
THESIS_RAG_CHUNK_MAX_CHARS=1600
THESIS_RAG_CHUNK_MAX_TOKENS=450
THESIS_RAG_CHUNK_OVERLAP_TOKENS=40
THESIS_RAG_TOKENIZER_CACHE_PATH=./data/huggingface
# Thesis filing retrieval
THESIS_RAG_RETRIEVAL_TOP_K=6
THESIS_RAG_RETRIEVAL_CANDIDATE_K=16
THESIS_RAG_RETRIEVAL_RERANK_ENABLED=true
# Chat-model input packing reserves output space for either counting path.
THESIS_RAG_GENERATION_RESERVED_OUTPUT_TOKENS=2048
THESIS_RAG_GENERATION_SAFETY_MARGIN_TOKENS=128
# Used with estimated counts when the chat tokenizer is unavailable or mismatched.
THESIS_RAG_GENERATION_FALLBACK_SAFETY_MARGIN_TOKENS=512
OLLAMA_TEMPERATURE=0.2
OLLAMA_NUM_CTX=16384

# Asset Snapshot eval judge (falls back to Ollama settings when empty)
EVAL_JUDGE_MODEL=
EVAL_JUDGE_BASE_URL=

# Market data
FMP_ENABLED=false
FMP_API_KEY=
FMP_BASE_URL=https://financialmodelingprep.com/stable

# LangSmith (https://smith.langchain.com)
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=spider-ai
