# App
APP_NAME=Spider
APP_ENV=local
APP_DEBUG=true
APP_PRETTY_LOGS=true
APP_LOG_FLOW_STEPS=true
APP_LOG_LLM_PROMPTS=false
APP_LOG_LLM_OUTPUTS=false
APP_LOG_PREVIEW_CHARS=600

# Local persistence (defaults to ./data/spider-ai.db)
SPIDER_AI_DB_PATH=./data/spider-ai.db
SPIDER_AI_SEC_FILINGS_PATH=./data/sec-filings
SPIDER_AI_CHROMA_PATH=./data/chroma

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# Change this when the locally installed embedding model weights/configuration change.
OLLAMA_EMBEDDING_MODEL_REVISION=local-v1
OLLAMA_EMBEDDING_BATCH_SIZE=32
OLLAMA_EMBEDDING_EXPECTED_DIMENSIONS=768
OLLAMA_EMBEDDING_MAX_INPUT_CHARS=1600
OLLAMA_EMBEDDING_MAX_INPUT_TOKENS=450
THESIS_RAG_CHUNK_MAX_CHARS=1600
THESIS_RAG_CHUNK_MAX_TOKENS=450
THESIS_RAG_CHUNK_OVERLAP_TOKENS=40
THESIS_RAG_TOKENIZER_CACHE_PATH=./data/huggingface
OLLAMA_TEMPERATURE=0.2

# Asset Snapshot eval judge (falls back to Ollama settings when empty)
EVAL_JUDGE_MODEL=
EVAL_JUDGE_BASE_URL=

# Market data
FMP_ENABLED=false
FMP_API_KEY=
FMP_BASE_URL=https://financialmodelingprep.com/stable

# LangSmith (https://smith.langchain.com)
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=spider-ai
