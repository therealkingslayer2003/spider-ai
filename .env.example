# App
APP_NAME=Spider
APP_ENV=local
APP_DEBUG=true
APP_PRETTY_LOGS=true
APP_LOG_FLOW_STEPS=true
APP_LOG_LLM_PROMPTS=false
APP_LOG_LLM_OUTPUTS=false
APP_LOG_PREVIEW_CHARS=600

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_TEMPERATURE=0.2

# Asset Snapshot eval judge (falls back to Ollama settings when empty)
EVAL_JUDGE_MODEL=
EVAL_JUDGE_BASE_URL=

# Market data
ASSET_PROFILE_CACHE_TTL_SECONDS=86400
FMP_ENABLED=false
FMP_API_KEY=
FMP_BASE_URL=https://financialmodelingprep.com/stable
FMP_CACHE_TTL_SECONDS=86400

# LangSmith (https://smith.langchain.com)
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=spider-ai
